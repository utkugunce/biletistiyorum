# Vercel server only. Configure actual values privately in Environment Variables.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ZEREN_ADMIN_PASSWORD=
ZEREN_COMPANION_TOKEN=

# Windows companion (never install a service-role database key on this machine).
ZEREN_CLOUD_URL=https://biletistiyorum.vercel.app
# ZEREN_COMPANION_TOKEN must match the server value and contain at least 32 random characters.
# ZEREN_MATCH_ID is optional for a single explicitly chosen match; otherwise bind
# cloud_match_id in each match's mac_bilet_plani.json.
ZEREN_MATCH_ID=
ZEREN_BIND_HOST=127.0.0.1
