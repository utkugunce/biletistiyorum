{
  "version": 2,
  "name": "biletistiyorum",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/portal/staff",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/portal/matches",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/bilet_app/:path*",
      "destination": "/api/admin"
    },
    {
      "source": "/biletistiyorum/:path*",
      "destination": "/api/admin"
    },
    {
      "source": "/api/portal/matches",
      "destination": "/api/matches"
    },
    {
      "source": "/api/portal/staff",
      "destination": "/api/staff"
    },
    {
      "source": "/api/portal/my-requests",
      "destination": "/api/my-requests"
    },
    {
      "source": "/api/portal/request",
      "destination": "/api/request"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/admin"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/panel",
      "destination": "/admin.html"
    },
    {
      "source": "/yonetim",
      "destination": "/admin.html"
    },
    {
      "source": "/bilet-istiyorum",
      "destination": "/index.html"
    },
    {
      "source": "/talep",
      "destination": "/index.html"
    }
  ]
}
